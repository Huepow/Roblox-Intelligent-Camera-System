-- Function to check if mouse is over a shop UI element
local function isMouseOverShopElement()
	local mouseLocation = UserInputService:GetMouseLocation()
	local guisAtPosition = playerGui:GetGuiObjectsAtPosition(mouseLocation.X, mouseLocation.Y)
	
	for _, gui in ipairs(guisAtPosition) do
		local parent = gui
		while parent do
			if parent:IsA("ScreenGui") then
				local guiNameLower = parent.Name:lower()
				if guiNameLower:find("shop") or 
				   guiNameLower:find("store") or 
				   guiNameLower:find("purchase") or 
				   guiNameLower:find("inventory") then
					return true
				end
			end
			parent = parent.Parent
		end
	end
	return false
end

-- Enhanced shop UI detection
local function detectShopUIs()
	activeShopGuis = {}
	
	for _, gui in ipairs(playerGui:GetChildren()) do
		if gui:IsA("ScreenGui") and gui.Enabled then
			local guiNameLower = gui.Name:lower()
			
			if guiNameLower:find("shop") or 
			   guiNameLower:find("store") or 
			   guiNameLower:find("purchase") or 
			   guiNameLower:find("buy") or
			   guiNameLower:find("inventory") or
			   guiNameLower:find("catalog") or
			   guiNameLower:find("market") then
				table.insert(activeShopGuis, gui)
			end
			
			local shopFrame = gui:FindFirstChild("ShopFrame") or 
			                 gui:FindFirstChild("StoreFrame") or
			                 gui:FindFirstChild("PurchaseFrame")
			if shopFrame and shopFrame.Visible then
				table.insert(activeShopGuis, gui)
			end
		end
	end
	
	return #activeShopGuis > 0
end

-- Smart shop UI state management
local function updateShopUIState()
	local wasShopOpen = shopUIActive
	shopUIActive = detectShopUIs()
	mouseOverShopUI = isMouseOverShopElement()
	
	if shopUIActive then
		STATE.shopUIRequiresMouse = mouseOverShopUI
		
		if STATE.shopUIRequiresMouse and not STATE.temporaryMouseRelease then
			STATE.temporaryMouseRelease = true
			if (STATE.mode == 1 or STATE.mode == 2) and isRMB then
				UserInputService.MouseBehavior = Enum.MouseBehavior.Default
				UserInputService.MouseIconEnabled = true
			end
		end
	else
		STATE.shopUIRequiresMouse = false
		STATE.temporaryMouseRelease = false
	end
	
	if not STATE.shopUIRequiresMouse and STATE.temporaryMouseRelease then
		STATE.temporaryMouseRelease = false
	end
end

